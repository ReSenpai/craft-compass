package-as: CraftCompass

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Only the addon goes into the zip: repository settings and templates stay in the repository.
# LICENSE, NOTICE, README and CHANGELOG ship.
ignore:
  - .github
  - .editorconfig
  - .gitattributes
  - .gitignore
  - CONTRIBUTING.md
  - SECURITY.md
  - .tools
  - tests
  - tools
