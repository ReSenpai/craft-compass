package-as: CraftCompass

# CurseForge relations of every uploaded file (they are set per file, not per project): the app installs the
# required ones along with Craft Compass.
required-dependencies:
  - atlasloot-continued
optional-dependencies:
  - questie

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Only the addon goes into the zip: repository settings and templates stay in the repository.
# LICENSE, NOTICE, README and CHANGELOG ship.
ignore:
  - .github
  - art
  - .editorconfig
  - .gitattributes
  - .gitignore
  - docs
  - CONTRIBUTING.md
  - SECURITY.md
  - .tools
  - tests
  - tools
